<mvc:View
    controllerName="demo.purchase.project101app.controller.PurchaseList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page title="Purchase List">
        <content>
            <VBox>
                <Input id="title" placeholder="标题" />
                <Input id="amount" placeholder="金额" />
                <Button text="提交1" press="onSubmit" />
                <Button text="查询2" press="onSelect" />
                
                <!-- 方法一：js绑定数据 -->
                <List
                    id="list"   
                    select="onItemPress"
                    mode="SingleSelectMaster" 
                >
                </List>
                <!-- 方法二：页面绑定方式items -->
                <!-- <List
                    id="list"
                    items="{/Purchases}"
                    mode="SingleSelectMaster"
                    itemPress="onItemPress">
                    <StandardListItem title="{title}"/>
                </List> -->

            </VBox>
        </content>
    </Page>
</mvc:View>
