<mvc:View
    controllerName="demo.purchase.project101app.controller.PurchaseList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page title="Purchase List">
        <content>
            <VBox>
                <Input id="title" placeholder="标题" />
                <Input id="amount" placeholder="金额" />
                <Button text="提交1" press="onSubmit" />
                <Button text="查询2" press="onSelect" />
                <List
                    id="list"
                    select="onItemPress"
                    mode="SingleSelectMaster"
                /> 

            </VBox>
        </content>
    </Page>
</mvc:View>
